---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import Faq from '../components/Faq.astro';
import { specialties, generalFaq, whatsapp } from '../data/site';
const faqs = generalFaq.slice(0,3);
---
<Layout title="Equipo terapéutico en Caseros" description="Carpe Diem: acompañamiento terapéutico interdisciplinario para infancias y familias en Caseros. Conocé las especialidades y consultá por WhatsApp." faqs={faqs}>
<section class="hero container"><div class="hero-copy"><p class="eyebrow">Infancia · Desarrollo · Vínculos</p><h1>Cada infancia<br/>es <em>única.</em></h1><p class="hero-lead">Acompañar también<br/>es parte del camino.</p><p>Somos Carpe Diem, un equipo terapéutico interdisciplinario en Caseros. Acompañamos a niños, niñas, adolescentes y familias desde una mirada cercana y respetuosa de cada proceso.</p><div class="actions"><a class="button" href={whatsapp()}>Hablemos por WhatsApp</a><a class="text-link" href="/especialidades/">Conocé las especialidades</a></div><p class="location">Caseros · Tres de Febrero · Buenos Aires</p></div><div class="hero-visual"><img src="/logo.jpg" width="1280" height="1280" alt="Carpe Diem – Equipo Terapéutico Interdisciplinario" fetchpriority="high"/><p>Familias reales.<br/>Historias únicas.<br/><strong>Más posibilidades.</strong></p></div></section>
<section class="manifesto"><div class="container manifesto-inner"><p class="eyebrow">Una mirada compartida</p><h2>No hay un solo camino.<br/>Lo construimos en equipo.</h2><p>Cada niño y niña tiene sus tiempos, intereses y formas de descubrir el mundo. El diálogo entre profesionales, familia y escuela nos ayuda a acompañar esa singularidad en la vida cotidiana.</p><a class="text-link" href="/nosotros/">Nuestra forma de acompañar</a></div></section>
<section class="section container"><div class="section-heading"><div><p class="eyebrow">Miradas que se encuentran</p><h2>Nuestras especialidades</h2></div><p>Distintas disciplinas.<br/>Un acompañamiento que se construye juntos.</p></div><Cards items={specialties} base="/especialidades/"/></section>
<section class="container home-split section"><div class="soft-panel"><p class="eyebrow">El equipo</p><h2>Personas que acompañan personas.</h2><p>Conocé a Marianela Belén Salgado, profesional de Psicopedagogía de Carpe Diem.</p><a class="text-link" href="/equipo/marianela-belen-salgado/">Conocé a Marianela</a></div><div class="soft-panel peach"><p class="eyebrow">Espacios para compartir</p><h2>Vínculos, encuentros y posibilidades.</h2><p>Consultá por el taller de habilidades sociales y conocé la propuesta del equipo.</p><a class="text-link" href="/talleres/habilidades-sociales/">Conocé el taller</a></div></section>
<section class="section container narrow"><p class="eyebrow">Para las familias</p><h2>Cada pregunta es un comienzo.</h2><p>Si estás buscando orientación, estas respuestas pueden ayudarte a dar el primer paso.</p><Faq items={faqs}/><a class="text-link" href="/familias/preguntas-frecuentes/">Ver todas las preguntas frecuentes</a></section>
</Layout>
