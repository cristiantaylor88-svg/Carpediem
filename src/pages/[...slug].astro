---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import Faq from '../components/Faq.astro';
import { site, specialties, professionals, workshops, generalFaq, whatsapp } from '../data/site';
export function getStaticPaths() {
 const roots=['equipo','especialidades','talleres','familias','familias/preguntas-frecuentes','nosotros','contacto'];
 return [...roots,...specialties.map(x=>`especialidades/${x.slug}`),...professionals.map(x=>`equipo/${x.slug}`),...workshops.map(x=>`talleres/${x.slug}`)].map(slug=>({params:{slug}}));
}
const slug=Astro.params.slug!;
const specialty=specialties.find(x=>slug===`especialidades/${x.slug}`);
const person=professionals.find(x=>slug===`equipo/${x.slug}`);
const workshop=workshops.find(x=>slug===`talleres/${x.slug}`);
const content = {
 'equipo':['Nuestro equipo','Personas que acompañan personas.','El trabajo interdisciplinario reúne distintas miradas para acompañar a cada niño, niña y adolescente, junto a su familia.'],
 'especialidades':['Especialidades en Caseros','Distintas miradas. Un camino compartido.','Conocé las especialidades de Carpe Diem. Si no sabés por dónde empezar, podés conversar con el equipo.'],
 'talleres':['Talleres','Encuentros que abren posibilidades.','Conocé la propuesta de habilidades sociales y consultá al equipo por sus próximos encuentros.'],
 'familias':['Para las familias','Acompañar también es aprender.','Este es un espacio para encontrar respuestas, conocer al equipo y acercarte a una consulta con información clara.'],
 'familias/preguntas-frecuentes':['Preguntas frecuentes','Cada pregunta merece ser escuchada.','Encontrá respuestas sobre cómo consultar, dónde estamos y qué información podés pedir antes de comenzar.'],
 'nosotros':['Sobre Carpe Diem','Cada historia tiene su propio camino.','Somos un equipo terapéutico interdisciplinario de atención presencial en Caseros. Acompañamos a niños, niñas, adolescentes y familias desde una mirada integral.'],
 'contacto':['Contacto','Hablemos.','Si tenés una inquietud o querés conocer nuestras propuestas, escribinos. Estamos para escucharte.']
};
const [title,heading,intro]=specialty ? [specialty.name+' en Caseros',specialty.name,specialty.intro] : person ? [person.name,person.name,person.description] : workshop ? ['Taller de '+workshop.name,workshop.name,workshop.intro] : content[slug];
const faqs=slug==='familias/preguntas-frecuentes'?generalFaq:specialty ? specialty.faq || [[`¿Cómo consulto por ${specialty.name}?`,'Escribinos por WhatsApp para conocer el profesional a cargo, las edades de atención, la modalidad y la disponibilidad.'],['¿Puedo consultar si no sé qué acompañamiento necesito?','Sí. Podés comunicarte con el equipo y contar brevemente el motivo de consulta. La orientación para cada situación requiere el criterio profesional.']] : [];
---
<Layout title={title} description={intro} faqs={faqs} person={person}>
<div class="container breadcrumbs"><a href="/">Inicio</a><span>/</span>{slug.includes('/') && <><a href={`/${slug.split('/')[0]}/`}>{slug.split('/')[0]==='familias'?'Familias':slug.split('/')[0]==='equipo'?'Equipo':slug.split('/')[0]==='talleres'?'Talleres':'Especialidades'}</a><span>/</span></>}<span>{title}</span></div>
<section class="page-intro container"><p class="eyebrow">Carpe Diem · Caseros</p><h1>{heading}</h1><p class="intro">{intro}</p></section>
{specialty && <><section class="container section detail-grid"><div><h2>Una consulta para comprender.</h2><p>{specialty.focus}</p><p>Cada proceso es singular. La información de esta página es general; el acompañamiento se define en una consulta profesional.</p></div><aside class="soft-panel"><h2>Conversemos</h2>{specialty.professional && <p>Psicopedagogía: <a href="/equipo/marianela-belen-salgado/">{specialty.professional}</a>.</p>}<p>Consultá por disponibilidad, edades de atención y modalidad.</p><a class="button" href={whatsapp(specialty.name)}>Consultar por {specialty.name}</a></aside></section><section class="container section narrow"><h2>Preguntas sobre {specialty.name}</h2><Faq items={faqs}/></section></>}
{slug==='especialidades' && <section class="section container"><Cards items={specialties} base="/especialidades/"/></section>}
{slug==='equipo' && <section class="section container"><Cards items={professionals} base="/equipo/"/><p class="editorial-note">Podés consultar al equipo quién está a cargo de cada especialidad.</p><a class="text-link" href="/especialidades/">Ver las especialidades</a></section>}
{person && <section class="section container detail-grid"><div><p class="eyebrow">Psicopedagogía</p><h2>Marianela Belén Salgado</h2><p>Marianela forma parte de Carpe Diem en el área de Psicopedagogía. Para conocer su modalidad de atención y consultar disponibilidad, comunicate con el equipo.</p><a class="text-link" href="/especialidades/psicopedagogia/">Conocer Psicopedagogía</a></div><aside class="soft-panel"><h2>Dar el primer paso</h2><p>Una conversación puede ayudarte a conocer la propuesta y organizar tu consulta.</p><a class="button" href={whatsapp('Psicopedagogía con Marianela Belén Salgado')}>Consultar por WhatsApp</a></aside></section>}
{slug==='talleres' && <section class="section container"><Cards items={workshops} base="/talleres/"/></section>}
{workshop && <section class="section container detail-grid"><div><h2>Conocé la propuesta</h2><p>{workshop.description}</p><p>La participación y los objetivos de cada espacio se conversan con el equipo, respetando las necesidades de cada persona.</p></div><aside class="soft-panel peach"><h2>¿Querés saber más?</h2><p>Consultá por edades, inscripción, fechas y modalidad.</p><a class="button" href={whatsapp('el taller de habilidades sociales')}>Consultar por el taller</a></aside></section>}
{slug==='familias' && <section class="section container"><div class="home-split"><a class="soft-panel linked-panel" href="/familias/preguntas-frecuentes/"><p class="eyebrow">Respuestas para empezar</p><h2>Preguntas frecuentes</h2><p>Cómo consultar, cómo llegar y qué podés preguntar al equipo.</p><span class="text-link">Encontrá respuestas</span></a><a class="soft-panel peach linked-panel" href="/especialidades/"><p class="eyebrow">Conocer para acompañar</p><h2>Las especialidades</h2><p>Un primer acercamiento a las distintas áreas del equipo.</p><span class="text-link">Conocé las propuestas</span></a></div><div class="reading-note"><h2>Una mirada respetuosa de cada proceso</h2><p>Las preguntas de las familias son parte del acompañamiento. Este espacio crecerá con contenidos revisados por profesionales, para compartir información clara y situada en la vida cotidiana.</p><p>Si tu pregunta tiene que ver con una situación particular, conversá con el equipo.</p></div></section>}
{slug==='familias/preguntas-frecuentes' && <section class="section container narrow"><Faq items={faqs}/></section>}
{slug==='nosotros' && <section class="section container"><div class="detail-grid"><div><h2>Una mirada integral se construye juntos.</h2><p>Cada disciplina aporta una perspectiva. El trabajo interdisciplinario conecta esas miradas para pensar el acompañamiento desde las fortalezas, necesidades y contextos de cada persona.</p><p>La familia, la escuela y los profesionales involucrados forman parte de ese diálogo. Escuchar y compartir información ayuda a construir estrategias coherentes para la vida cotidiana.</p></div><div class="soft-panel"><p class="eyebrow">Nuestra forma de acompañar</p><h2>Escucha.<br/>Singularidad.<br/>Trabajo en equipo.</h2><p>Sin comparar caminos ni prometer resultados. Con respeto por cada historia y por los tiempos de cada proceso.</p></div></div><div class="actions"><a class="text-link" href="/equipo/">Conocé al equipo</a><a class="text-link" href="/especialidades/">Conocé las especialidades</a></div></section>}
{slug==='contacto' && <section class="section container detail-grid"><div class="soft-panel"><h2>Consultas por WhatsApp</h2><p>Escribinos para consultar por una especialidad, los talleres o la disponibilidad de atención.</p><p><strong>{site.phone}</strong></p><a class="button" href={whatsapp()}>Abrir WhatsApp</a><p class="editorial-note">Para el primer contacto alcanza con un motivo general de consulta. Evitá enviar información clínica sensible.</p><a class="text-link" href={site.instagram}>Encontranos en Instagram</a></div><div><h2>Estamos en Caseros</h2><address>{site.address}</address><p>Atención presencial. Coordiná tu visita con el equipo antes de acercarte.</p><a class="text-link" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.address)}`}>Ver ubicación en Google Maps</a><div class="reading-note"><h3>¿No sabés por dónde empezar?</h3><p>Podés escribirnos para conocer las propuestas del equipo. La orientación para tu situación se conversa con los profesionales.</p><a href="/familias/preguntas-frecuentes/">Leer preguntas frecuentes</a></div></div></section>}
</Layout>
