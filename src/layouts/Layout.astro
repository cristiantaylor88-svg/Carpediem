---
import '../styles/global.css';
import { site, whatsapp } from '../data/site';
const { title, description, faqs = [], person, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const nav = [['Equipo','/equipo/'],['Especialidades','/especialidades/'],['Talleres','/talleres/'],['Familias','/familias/'],['Nosotros','/nosotros/'],['Contacto','/contacto/']];
const organization = { '@type':'Organization', '@id':`${site.url}/#organizacion`, name:site.name, url:site.url, telephone:site.phone, logo:`${site.url}/logo.jpg`, sameAs:[site.instagram], address:{'@type':'PostalAddress',streetAddress:'Dr. Amadeo Sabattini 4954 5B',addressLocality:'Caseros',addressRegion:'Buenos Aires',addressCountry:'AR'} };
const crumbs = Astro.url.pathname.split('/').filter(Boolean);
const graph = [organization, { '@type':'WebSite','@id':`${site.url}/#web`, url:site.url, name:site.name, inLanguage:'es-AR', publisher:{'@id':organization['@id']} }, { '@type':'WebPage', '@id':`${canonical}#pagina`,url:canonical,name:title,description,inLanguage:'es-AR',isPartOf:{'@id':`${site.url}/#web`} }, ...(crumbs.length ? [{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Inicio',item:site.url+'/'},...crumbs.map((c,i)=>({'@type':'ListItem',position:i+2,name:i===crumbs.length-1?title.split(' | ')[0]:c.charAt(0).toUpperCase()+c.slice(1),item:site.url+'/'+crumbs.slice(0,i+1).join('/')+'/'}))]}] : []), ...(faqs.length ? [{'@type':'FAQPage',mainEntity:faqs.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}] : []), ...(person ? [{'@type':'Person',name:person.name,url:canonical,worksFor:{'@id':organization['@id']}}] : [])];
---
<!doctype html><html lang="es-AR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} | Carpe Diem</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>{noindex && <meta name="robots" content="noindex,follow"/>}<link rel="icon" href="/logo.jpg" type="image/jpeg"/><meta property="og:type" content="website"/><meta property="og:title" content={`${title} | Carpe Diem`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={site.name}/><meta property="og:locale" content="es_AR"/><meta property="og:image" content={`${site.url}/logo.jpg`}/><meta property="og:image:alt" content="Logo oficial de Carpe Diem"/><meta name="twitter:card" content="summary"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')}/></head><body>
<a class="skip" href="#contenido">Ir al contenido</a>
<header class="header"><div class="container header-inner"><a class="brand" href="/" aria-label="Carpe Diem, inicio"><img src="/logo.jpg" width="58" height="58" alt=""/><span>Carpe Diem<small>Equipo Terapéutico Interdisciplinario</small></span></a><nav aria-label="Principal" class="desktop-nav">{nav.map(([label,url])=><a href={url} aria-current={Astro.url.pathname.startsWith(url)?'page':undefined}>{label}</a>)}</nav><details class="mobile-nav"><summary>Menú</summary><nav aria-label="Principal móvil">{nav.map(([label,url])=><a href={url}>{label}</a>)}</nav></details></div></header>
<main id="contenido"><slot/></main>
<section class="contact-band" aria-labelledby="hablemos"><div class="container contact-inner"><div><p class="eyebrow">Un primer paso, a tu ritmo</p><h2 id="hablemos">Hablemos.</h2><p>Estamos para escucharte y acompañarte.</p></div><a class="button" href={whatsapp()}>Conversar por WhatsApp</a></div></section>
<footer><div class="container footer-grid"><div class="footer-brand">Carpe Diem<small>Equipo Terapéutico Interdisciplinario</small><p>Cada historia merece su propio camino.</p></div><div><strong>Encontranos en Caseros</strong><address>{site.address}</address><a href="/contacto/">Cómo llegar y consultar</a></div><div><strong>Sigamos en contacto</strong><a href={whatsapp()}>{site.phone}</a><a href={site.instagram}>Instagram · @carpediemequipo</a><a href="/familias/preguntas-frecuentes/">Preguntas frecuentes</a></div></div><div class="container footer-note">© {new Date().getFullYear()} Carpe Diem. La información de este sitio es orientativa y no reemplaza una consulta profesional.</div></footer>
</body></html>
